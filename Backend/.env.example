# Copy to .env and paste the connection URI from your Tiger Data service.
# Never put this URI into frontend code or commit it to Git.
# Example shape (replace all placeholders):
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full
DATABASE_URL=

# Local server; visit PUBLIC_ORIGIN so Origin/CSRF checks match.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
COOKIE_SECURE=false

# Optional video storage and remux executable. Defaults: Backend/.recordings
# and Backend/.tools/ffmpeg/ffmpeg.exe (Windows), then ffmpeg on PATH.
RECORDINGS_DIR=
FFMPEG_PATH=

# Both seed opt-in and a private password (12–256 chars) are required to seed.
ALLOW_SYNTHETIC_SEED=false
DEMO_PASSWORD=
# Synthetic camera: only the labeled demo group; real cameras stay unavailable.
ALLOW_SYNTHETIC_CAMERA=false
ALLOW_FICTIONAL_ALERT_DEMO=false

# Optional native test: exclusively a dedicated EMPTY disposable Timescale DB.
# Never set this to your development or production DATABASE_URL.
TIMESCALE_TEST_DATABASE_URL=
TIMESCALE_TEST_ALLOW_EMPTY_DATABASE=false

# Optional consenting-adult pickup demo. Use server roster UUIDs, never names.
# Leave disabled until all participants have agreed to face recognition/sharing.
PICKUP_DEMO_ENABLED=false
PICKUP_LEO_ID=
PICKUP_REBECA_ID=
PICKUP_ANTHONY_ID=
PICKUP_APPROVAL_EMAIL=
PICKUP_SMTP_HOST=
PICKUP_SMTP_PORT=587
PICKUP_SMTP_MODE=starttls
PICKUP_SMTP_FROM=
PICKUP_SMTP_USER=
PICKUP_SMTP_PASSWORD=
# Independent SubjectRegistry reader (server-side credential only).
# Production requires a separately deployed HTTPS registry.
SUBJECT_REGISTRY_URL=
SUBJECT_REGISTRY_READ_KEY=
